# ---- LocalTube main server (optional) ----
# Address users' apps connect to for synced accounts. Leave empty to use the
# same address the app is opened from. Example: https://tube.example.com
VITE_LOCALTUBE_SERVER='http://192.168.1.10:9000'

# DATABASE_URL (your Neon connection string) lives in .env.local, which is
# git-ignored, so the database password never lands in the repository.

