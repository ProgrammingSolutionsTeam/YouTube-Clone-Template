# ---- LocalTube main server (optional) ----
# Address users' apps connect to for synced accounts. Leave empty to use the
# same address the app is opened from. Example: https://tube.example.com
VITE_LOCALTUBE_SERVER=

# Server only — never sent to browsers. Put your Neon connection string in
# .env.local (git-ignored) rather than .env, so the password is never committed:
DATABASE_URL=
